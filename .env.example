# Model selection: "gpt-4o-mini", "gpt-4o", "gemini-2.0-flash", "gemini-1.5-flash", etc.
MODEL_NAME=gpt-4o-mini

# API key OpenAI (dùng khi MODEL_NAME là model OpenAI như gpt-4o-mini)
OPENAI_API_KEY=your-openai-api-key-here

# API key Gemini — lấy tại https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key-here

# Giữ = 0 nếu dùng Google AI Studio (không dùng Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=0

